# Настроить VPN между двумя ВМ в tun/tap режимах, замерить скорость в туннелях,
# сделать вывод об отличающихся показателях

# запускаю опенвпн на сервере, поднимаю виртуальный сетевой интрефейс tan0
[vagrant@vpnserver ~]$ sudo openvpn --config /etc/openvpn/server-tun.conf --daemon
[vagrant@vpnserver ~]$ ip -brief addr show tun0
tun0             UNKNOWN        10.10.10.1 peer 10.10.10.2/32 fe80::f6db:4c6e:77e8:60a8/64

[vagrant@vpnserver ~]$ ss -ulnp | grep 1194
UNCONN 0      0            0.0.0.0:1194      0.0.0.0:*

[vagrant@vpnserver ~]$ sudo iperf3 -s -D
[vagrant@vpnserver ~]$ ss -tlnp | grep 5201
LISTEN 0      4096               *:5201            *:*

# выключение процессов
[vagrant@vpnserver ~]$ sudo pkill -9 iperf3
[vagrant@vpnserver ~]$ sudo pkill -9 openvpn

